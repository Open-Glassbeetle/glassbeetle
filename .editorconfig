# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.md]
# Repository Markdown is hard-wrapped at 80 columns by hand; do not let
# editors or Prettier reflow it. Prettier globs intentionally exclude *.md.
max_line_length = off
trim_trailing_whitespace = false

[*.rs]
# rustfmt defaults; cargo fmt is not part of `npm run format` (see CONTRIBUTING).
indent_size = 4
