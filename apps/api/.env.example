# Glassbeetle API configuration.
#
# Every setting is optional: the API starts with sensible per-user defaults.
# Copy this file to `.env` only if you need to override something.

# Run mode: development | production | test
# NODE_ENV=development

# Port the API listens on. It binds to 127.0.0.1 only.
# PORT=3000

# Root directory for the database, uploaded files, artifacts and backups.
# Must be an absolute path. Defaults to a per-user application data directory:
#   macOS   ~/Library/Application Support/Glassbeetle
#   Windows %APPDATA%\Glassbeetle
#   Linux   $XDG_DATA_HOME/glassbeetle (or ~/.local/share/glassbeetle)
# GLASSBEETLE_DATA_DIR=/absolute/path/to/data

# Absolute path of the SQLite database file.
# Defaults to <data dir>/glassbeetle.db
# GLASSBEETLE_DATABASE_PATH=/absolute/path/to/glassbeetle.db

# Comma-separated CORS allowlist. Defaults to the three origins the desktop app
# uses. Set it to an empty value to allow no cross-origin requests at all.
# GLASSBEETLE_CORS_ORIGINS=http://localhost:4200,tauri://localhost,http://tauri.localhost
