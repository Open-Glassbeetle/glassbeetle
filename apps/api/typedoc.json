{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Glassbeetle API",
  "entryPointStrategy": "expand",
  "entryPoints": ["src"],
  "exclude": ["**/*.spec.ts"],
  "out": "docs-site",
  "tsconfig": "tsconfig.build.json",
  "skipErrorChecking": true,
  "excludePrivate": false,
  "excludeExternals": true,
  "categorizeByGroup": true,
  "sort": ["kind", "alphabetical"],
  "navigationLinks": {
    "Repository": "https://github.com/Open-Glassbeetle/glassbeetle",
    "Conventions": "https://github.com/Open-Glassbeetle/glassbeetle/blob/main/docs/README.md"
  },
  "validation": {
    "invalidLink": true,
    "notExported": true,
    "notDocumented": false
  }
}
