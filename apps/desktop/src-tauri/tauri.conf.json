{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glassbeetle",
  "version": "0.1.0",
  "identifier": "com.glassbeetle.app",
  "build": {
    "frontendDist": "../../web/dist/web/browser",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build -w @glassbeetle/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glassbeetle",
        "width": 1240,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
